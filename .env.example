# ---- Database ----
POSTGRES_USER=querymind
POSTGRES_PASSWORD=querymind
POSTGRES_DB=querymind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full DSN, used directly by Python scripts
DATABASE_URL=postgresql://xxxx.xxxx@xxxx/postgres

# ---- Read-only execution role (Phase 2) ----
# A separate Postgres role with SELECT-only grants on the 8 business
# tables (see data/seed/create_readonly_role.sql). The agent's execute_sql
# node connects with THIS DSN, not DATABASE_URL -- so even a validated
# query runs under a role that has no INSERT/UPDATE/DELETE/DDL privileges
# and no grants on schema_documents at all, as defense-in-depth behind
# the sqlglot guardrail.
READONLY_DATABASE_URL=postgresql://postgresql://<readonly_db>.xxxx:@xxxx/postgres

# ---- LLM provider (pluggable) ----
# One of: "anthropic" | "openai" | "mock"
# "mock" is a deterministic, keyword-matched stand-in for local testing
# without an API key -- see backend/app/agent/llm.py docstring for what
# it does and doesn't cover. Use "anthropic" or "openai" for real use.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=llama-xxxxx
OPENAI_BASE_URL=https://api.groq.com/openai/v1


# ---- Embeddings (used for pgvector ingestion + retrieval, Phase 1) ----
# One of: "local" | "openai"
# "local" is a dependency-light deterministic hashing embedder (no API key,
# no model download) — good enough to prove the RAG pipeline works.
# Swap to "openai" for real semantic embeddings once an API key is set.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- LangSmith observability (Phase 2+) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=querymind

# ---- App ----
ENV=development
LOG_LEVEL=INFO
